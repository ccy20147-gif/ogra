{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ogra.dev/spec/v0alpha1/schemas/payload-ref.schema.json",
  "title": "PayloadRef",
  "description": "Reference to sanctioned payload material. storage_mode distinguishes evidence-only, encrypted replayable, and external retrieval. Implements PROT-025, PROT-026, PROT-027.",
  "type": "object",
  "properties": {
    "protocol_version": { "const": "0.1" },
    "storage_mode": {
      "enum": ["hash_only", "encrypted_replayable", "external_reference"]
    },
    "content_hash": { "$ref": "https://ogra.dev/spec/v0alpha1/schemas/_defs.schema.json#/$defs/HashRef" },
    "replay_eligible": { "type": "boolean" },
    "size_bytes": { "$ref": "https://ogra.dev/spec/v0alpha1/schemas/_defs.schema.json#/$defs/SafeInteger", "minimum": 0 },
    "mime_type": { "type": "string", "maxLength": 128 },
    "storage_ref": { "type": "string", "minLength": 1, "maxLength": 256 },
    "key_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "encryption_scheme": { "type": "string", "minLength": 1, "maxLength": 64 },
    "retention_class": { "type": "string", "minLength": 1, "maxLength": 64 },
    "expires_at": { "$ref": "https://ogra.dev/spec/v0alpha1/schemas/_defs.schema.json#/$defs/Timestamp" },
    "deleted": { "type": "boolean", "default": false },
    "external_store": { "type": "string", "minLength": 1, "maxLength": 256 },
    "retrieval_policy": { "enum": ["immediate", "delegated", "unknown"] }
  },
  "required": ["protocol_version", "storage_mode", "content_hash", "replay_eligible"],
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "storage_mode": { "const": "hash_only" } } },
      "then": {
        "properties": { "replay_eligible": { "const": false } },
        "description": "A hash-only payload proves identity but cannot be replayed (PROT-026)."
      }
    },
    {
      "if": { "properties": { "storage_mode": { "const": "encrypted_replayable" } } },
      "then": {
        "required": ["storage_ref", "key_id", "encryption_scheme", "retention_class", "expires_at"]
      }
    },
    {
      "if": { "properties": { "storage_mode": { "const": "external_reference" } } },
      "then": { "required": ["external_store", "retrieval_policy"] }
    }
  ]
}
