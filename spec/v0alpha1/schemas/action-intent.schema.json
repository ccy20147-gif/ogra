{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ogra.dev/spec/v0alpha1/schemas/action-intent.schema.json",
  "title": "ActionIntent",
  "description": "What the Agent intends to do: the proposal for one governed external call. Principal and workspace are bound by the server from the authenticated context, never accepted from this payload (P0 invariant).",
  "type": "object",
  "properties": {
    "protocol_version": { "const": "0.1" },
    "run_id": { "type": "string", "pattern": "^run_[0-9a-hjkmnp-tv-z]{26}$" },
    "submission_key": { "$ref": "https://ogra.dev/spec/v0alpha1/schemas/_defs.schema.json#/$defs/SubmissionKey" },
    "intent": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": ["model_call", "tool_call", "delegation", "memory_write", "file_export", "side_effect"]
        },
        "operation_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "destination": { "$ref": "https://ogra.dev/spec/v0alpha1/schemas/_defs.schema.json#/$defs/Destination" },
        "request": { "$ref": "https://ogra.dev/spec/v0alpha1/schemas/payload-ref.schema.json" },
        "metadata": {
          "type": "object",
          "description": "Extension point: preserved verbatim, never interpreted by core logic.",
          "additionalProperties": true
        }
      },
      "required": ["kind", "operation_id", "destination", "request"],
      "additionalProperties": false
    },
    "execution_profile": { "$ref": "https://ogra.dev/spec/v0alpha1/schemas/_defs.schema.json#/$defs/ExecutionProfile" },
    "policy_version": { "type": "string", "minLength": 1, "maxLength": 128 },
    "redaction_rule_version": { "type": "string", "minLength": 1, "maxLength": 128 },
    "correlation": { "$ref": "https://ogra.dev/spec/v0alpha1/schemas/_defs.schema.json#/$defs/CorrelationRef" },
    "proposed_at": { "$ref": "https://ogra.dev/spec/v0alpha1/schemas/_defs.schema.json#/$defs/Timestamp" }
  },
  "required": ["protocol_version", "run_id", "intent", "execution_profile", "proposed_at"],
  "additionalProperties": false
}
